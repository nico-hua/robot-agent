# Copy these project-wide settings to .env and adjust them locally.
# Local workspace used by SessionManager when no path is passed explicitly.
WORKSPACE_PATH=./workspace


# Supported types: openai_compat, ollama.
# This example uses the native Ollama SDK. To use an OpenAI-compatible endpoint,
# set PROVIDER_TYPE=openai_compat and replace the base URL and model below.
PROVIDER_TYPE=ollama
# Native local Ollama normally does not require a key. Do not commit a real key.
PROVIDER_API_KEY=
PROVIDER_API_BASE=http://127.0.0.1:11434
PROVIDER_MODEL=qwen3.5:4b
PROVIDER_MAX_TOKENS=1024
PROVIDER_TEMPERATURE=0.7
# Enable the provider's reasoning mode when it is supported by the selected provider.
PROVIDER_THINK=false
# Per-request Provider SDK timeout in seconds.
PROVIDER_REQUEST_TIMEOUT_SECONDS=60


# Local HTTP API settings. The default host avoids exposing the API to the LAN.
API_HOST=127.0.0.1
API_PORT=8000
API_REQUEST_TIMEOUT_SECONDS=60
