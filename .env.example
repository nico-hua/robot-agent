# Copy these project-wide settings to .env and adjust them locally.
# Local workspace used by SessionManager when no path is passed explicitly.
WORKSPACE_PATH=./workspace
# Supported type: openai_compat
PROVIDER_TYPE=openai_compat
# Leave blank only when the selected compatible endpoint does not need a key.
PROVIDER_API_KEY=
PROVIDER_API_BASE=https://api.openai.com/v1
PROVIDER_MODEL=your-model-name
PROVIDER_MAX_TOKENS=1024
PROVIDER_TEMPERATURE=0.7
# Local HTTP API settings. The default host avoids exposing the API to the LAN.
API_HOST=127.0.0.1
API_PORT=8000
API_REQUEST_TIMEOUT_SECONDS=60
